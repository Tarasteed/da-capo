 "pieces": [
  {"id": "vivaldi_printemps", "c": "vivaldi", "t": "Les Quatre Saisons, « Le Printemps »", "y": 1725, "approx": false, "cat": "RV 269", "form": null, "audio": "audio/vivaldi_printemps.mp3", "loop": 5.204, "fact": "Publiées à Amsterdam en 1725, Les Quatre Saisons sont accompagnées de sonnets qui décrivent chaque scène : chants d’oiseaux, ruisseaux, orage.", "stat": "Œuvre la plus jouée en concert en 2025 selon Bachtrack.", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "bach_prelude", "c": "bach", "t": "Prélude en do majeur, Clavier bien tempéré", "y": 1722, "approx": false, "cat": "BWV 846", "form": "clavecin", "audio": "audio/bach_prelude.mp3", "loop": 26.667, "fact": "Premier prélude d’un recueil qui parcourt les 24 tonalités. En 1853, Gounod lui superpose une mélodie : c’est son célèbre Ave Maria.", "stat": "Bach a été le 3e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": "2026-10-25", "src": null, "synth": true},
  {"id": "bach_cello", "c": "bach", "t": "Suite pour violoncelle n°1, Prélude", "y": 1720, "approx": true, "cat": "BWV 1007", "form": "violoncelle", "audio": "audio/bach_cello.mp3", "loop": 15.882, "fact": "Écrite vers 1720 à Köthen. Longtemps prises pour de simples exercices, ces suites ont été révélées au public par Pablo Casals, qui les enregistre de 1936 à 1939.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "bach_jesu", "c": "bach", "t": "« Jésus, que ma joie demeure »", "y": 1723, "approx": false, "cat": "BWV 147", "form": "hautbois", "audio": "audio/bach_jesu.mp3", "loop": 8.438, "fact": "Ce choral clôt une cantate créée à Leipzig en juillet 1723, la première année de Bach comme Cantor. L’arrangement pour piano de Myra Hess (1926) l’a rendu célèbre.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "bach_toccata", "c": "bach", "t": "Toccata et fugue en ré mineur", "y": null, "approx": true, "cat": "BWV 565", "form": "orgue", "audio": "audio/bach_toccata.mp3", "loop": 21.5, "fact": "La plus célèbre pièce pour orgue… dont l’attribution à Bach est contestée : le seul manuscrit connu est une copie tardive, réalisée par un autre musicien.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "petzold_menuet", "c": "petzold", "t": "Menuet en sol majeur", "y": 1725, "approx": true, "cat": "BWV Anh. 114", "form": "clavecin", "audio": "audio/petzold_menuet.mp3", "loop": 12, "fact": "Recopié dans le Petit Livre d’Anna Magdalena Bach, ce menuet a longtemps été attribué à Bach. Il est en réalité de Christian Petzold, organiste à Dresde.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "pachelbel_canon", "c": "pachelbel", "t": "Canon en ré majeur", "y": null, "approx": true, "cat": "P. 37", "form": null, "audio": "audio/pachelbel_canon.mp3", "loop": 18.621, "fact": "La même basse de huit notes revient en boucle tout au long de la pièce. Oublié pendant deux siècles, ce canon est devenu un tube après un enregistrement de Jean-François Paillard en 1968.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "handel_hallelujah", "c": "handel", "t": "Le Messie, chœur « Hallelujah »", "y": 1741, "approx": false, "cat": "HWV 56", "form": "choeur", "audio": "audio/handel_hallelujah.mp3", "loop": 5.676, "fact": "Haendel compose tout Le Messie en environ trois semaines, en 1741. Selon une tradition tenace, le public se lève pendant ce chœur depuis qu’un roi l’aurait fait.", "stat": "Haendel : 7e compositeur d’opéra le plus joué en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "haydn_surprise", "c": "haydn", "t": "Symphonie n°94 « La Surprise »", "y": 1791, "approx": false, "cat": "Hob. I:94", "form": null, "audio": "audio/haydn_surprise.mp3", "loop": 10.2, "fact": "Un thème murmuré, répété plus doucement encore, puis un accord fortissimo de tout l’orchestre : d’où le surnom. Elle est créée à Londres en 1792.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "haydn_emperor", "c": "haydn", "t": "Hymne à l’empereur, quatuor « L’Empereur »", "y": 1797, "approx": false, "cat": "Hob. III:77", "form": "violon", "audio": "audio/haydn_emperor.mp3", "loop": 14.545, "fact": "Écrit en 1797 pour l’empereur François II, puis repris dans un quatuor à cordes. Cette mélodie est aujourd’hui celle de l’hymne national allemand.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mozart_nacht", "c": "mozart", "t": "Eine kleine Nachtmusik", "y": 1787, "approx": false, "cat": "K. 525", "form": null, "audio": "audio/mozart_nacht.mp3", "loop": 7.273, "fact": "Achevée le 10 août 1787, pendant la composition de Don Giovanni. Elle n’a été publiée qu’après la mort de Mozart.", "stat": "Mozart a été le 2e compositeur le plus joué en concert en 2025, et le 1er à l’opéra (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mozart_40", "c": "mozart", "t": "Symphonie n°40 en sol mineur", "y": 1788, "approx": false, "cat": "K. 550", "form": null, "audio": "audio/mozart_40.mp3", "loop": 8.276, "fact": "L’une des trois dernières symphonies de Mozart, toutes écrites en six semaines, à l’été 1788.", "stat": "Mozart a été le 2e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": "2026-10-25", "src": null, "synth": true},
  {"id": "mozart_turca", "c": "mozart", "t": "Marche turque, Sonate n°11", "y": 1783, "approx": true, "cat": "K. 331", "form": "piano", "audio": "audio/mozart_turca.mp3", "loop": 8.71, "fact": "Mozart imite les fanfares des janissaires ottomans, très à la mode à Vienne. C’est le dernier mouvement d’une sonate pour piano.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mozart_545", "c": "mozart", "t": "Sonate pour piano « facile »", "y": 1788, "approx": false, "cat": "K. 545", "form": null, "audio": "audio/mozart_545.mp3", "loop": 8, "fact": "Mozart l’inscrit dans son catalogue comme une petite sonate « pour débutants ». Les élèves pianistes la jouent depuis plus de deux siècles.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mozart_twinkle", "c": "mozart", "t": "Variations sur « Ah ! vous dirai-je, maman »", "y": 1782, "approx": true, "cat": "K. 265", "form": "piano", "audio": "audio/mozart_twinkle.mp3", "loop": 9.231, "fact": "Mozart a écrit douze variations sur ce thème… qui n’est pas de lui : c’est une chanson populaire française. On la connaît aussi comme « Twinkle, Twinkle, Little Star ».", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "beethoven_5", "c": "beethoven", "t": "Symphonie n°5", "y": 1808, "approx": false, "cat": "Op. 67", "form": null, "audio": "audio/beethoven_5.mp3", "loop": 6.111, "fact": "Créée le 22 décembre 1808, lors d’un concert de quatre heures dans une salle glaciale, en même temps que la Symphonie n°6.", "stat": "Beethoven a été le compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "beethoven_elise", "c": "beethoven", "t": "Lettre à Élise", "y": 1810, "approx": false, "cat": "WoO 59", "form": "piano", "audio": "audio/beethoven_elise.mp3", "loop": 11.364, "fact": "Publiée en 1867, quarante ans après la mort de Beethoven. Le manuscrit est perdu, et l’identité d’« Élise » reste débattue.", "stat": "Beethoven a été le compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "beethoven_moon", "c": "beethoven", "t": "Sonate « Clair de lune »", "y": 1801, "approx": false, "cat": "Op. 27 n°2", "form": "piano", "audio": "audio/beethoven_moon.mp3", "loop": 13.846, "fact": "Beethoven l’avait appelée « Sonata quasi una fantasia ». Le surnom vient du critique Ludwig Rellstab, après la mort du compositeur.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "beethoven_ode", "c": "beethoven", "t": "Symphonie n°9, « Ode à la joie »", "y": 1824, "approx": false, "cat": "Op. 125", "form": null, "audio": "audio/beethoven_ode.mp3", "loop": 8.571, "fact": "À la création, Beethoven, complètement sourd, dut être retourné vers la salle pour voir le public applaudir. Ce thème est aujourd’hui l’hymne de l’Union européenne.", "stat": "Beethoven a été le compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "chopin_marche", "c": "chopin", "t": "Marche funèbre, Sonate n°2", "y": 1837, "approx": false, "cat": "Op. 35", "form": "piano", "audio": "audio/chopin_marche.mp3", "loop": 9.231, "fact": "Chopin écrit cette marche en 1837, puis l’intègre deux ans plus tard à sa Sonate n°2.", "stat": "Chopin a été le 7e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "wagner_valk", "c": "wagner", "t": "La Walkyrie, Chevauchée des Walkyries", "y": 1856, "approx": false, "cat": "WWV 86B", "form": null, "audio": "audio/wagner_valk.mp3", "loop": 10.435, "fact": "La Walkyrie est achevée en 1856 mais n’est créée qu’en 1870 à Munich, sur ordre du roi Louis II et contre la volonté de Wagner.", "stat": "Wagner : 4e compositeur d’opéra le plus joué en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "wagner_bridal", "c": "wagner", "t": "Lohengrin, chœur des fiançailles", "y": 1848, "approx": false, "cat": "WWV 75", "form": "orgue", "audio": "audio/wagner_bridal.mp3", "loop": 13.333, "fact": "La « marche nuptiale » des mariages vient de cet opéra, créé par Liszt à Weimar en 1850. Dans l’histoire, le mariage tourne pourtant mal dès la nuit de noces.", "stat": "Wagner : 4e compositeur d’opéra le plus joué en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "offenbach_cancan", "c": "offenbach", "t": "Orphée aux Enfers, galop infernal", "y": 1858, "approx": false, "cat": "", "form": null, "audio": "audio/offenbach_cancan.mp3", "loop": 6.8, "fact": "Dans l’opérette, ce galop fait danser les dieux de l’Olympe aux Enfers. Il est devenu l’air du french cancan.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "strauss_danube", "c": "jstrauss", "t": "Le Beau Danube bleu", "y": 1867, "approx": false, "cat": "Op. 314", "form": null, "audio": "audio/strauss_danube.mp3", "loop": 17.5, "fact": "Composée en 1867, cette valse est jouée chaque année en bis au concert du Nouvel An de Vienne.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "brahms_berceuse", "c": "brahms", "t": "Berceuse (Wiegenlied)", "y": 1868, "approx": false, "cat": "Op. 49 n°4", "form": null, "audio": "audio/brahms_berceuse.mp3", "loop": 16.304, "fact": "Écrite pour la naissance du deuxième fils de son amie Bertha Faber.", "stat": "Brahms a été le 5e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "bizet_habanera", "c": "bizet", "t": "Carmen, Habanera", "y": 1875, "approx": false, "cat": "", "form": "violon", "audio": "audio/bizet_habanera.mp3", "loop": 10, "fact": "Bizet croyait citer un air populaire : c’était une chanson de Sebastián Iradier. Il le signala ensuite dans la partition.", "stat": "Carmen a été le 2e opéra le plus joué au monde en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mussorgsky_promenade", "c": "mussorgsky", "t": "Tableaux d’une exposition, Promenade", "y": 1874, "approx": false, "cat": "", "form": "trompette", "audio": "audio/mussorgsky_promenade.mp3", "loop": 13.75, "fact": "Une promenade dans l’exposition de son ami peintre Viktor Hartmann. Dans l’orchestration de Ravel (1922), c’est une trompette seule qui ouvre l’œuvre.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "saintsaens_danse", "c": "saintsaens", "t": "Danse macabre", "y": 1874, "approx": false, "cat": "Op. 40", "form": null, "audio": "audio/saintsaens_danse.mp3", "loop": 8.365, "fact": "La harpe sonne douze fois minuit, puis la Mort accorde son violon : la corde de mi baissée en mi bémol fait entendre le triton, « l’intervalle du diable ».", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "grieg_hall", "c": "grieg", "t": "Peer Gynt, Dans l’antre du roi de la montagne", "y": 1875, "approx": false, "cat": "Op. 23", "form": "basson", "audio": "audio/grieg_hall.mp3", "loop": 8.889, "fact": "Musique de scène pour la pièce d’Ibsen. Grieg disait lui-même ne pas supporter ce morceau, qu’il trouvait d’un folklore trop appuyé.", "stat": null, "added": "2026-10-23", "retired": "2026-10-25", "src": null, "synth": true},
  {"id": "grieg_morning", "c": "grieg", "t": "Peer Gynt, Au matin", "y": 1875, "approx": false, "cat": "Op. 23", "form": null, "audio": "audio/grieg_morning.mp3", "loop": 14.545, "fact": "Un lever de soleil… qui se passe dans le désert marocain, à l’acte IV de la pièce d’Ibsen. La flûte et le hautbois s’y répondent.", "stat": null, "added": "2026-10-23", "retired": "2026-10-25", "src": null, "synth": true},
  {"id": "tchai_swan", "c": "tchaikovsky", "t": "Le Lac des cygnes, thème du cygne", "y": 1876, "approx": false, "cat": "Op. 20", "form": "hautbois", "audio": "audio/tchai_swan.mp3", "loop": 12.5, "fact": "Composé en 1875-1876, le ballet fut un échec à sa création au Bolchoï en 1877. Il ne triomphe qu’après la mort de Tchaïkovski.", "stat": "Le Lac des cygnes a été le 2e ballet le plus donné en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "tchai_sugar", "c": "tchaikovsky", "t": "Casse-Noisette, Danse de la Fée Dragée", "y": 1892, "approx": false, "cat": "Op. 71", "form": "celesta", "audio": "audio/tchai_sugar.mp3", "loop": 8.333, "fact": "Tchaïkovski découvre le célesta à Paris en 1891 et demande qu’on garde le secret, pour être le premier à l’utiliser en Russie.", "stat": "Casse-Noisette reste le ballet le plus donné au monde : 693 représentations recensées en 2025 (Bachtrack).", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "satie_gymno", "c": "satie", "t": "Gymnopédie n°1", "y": 1888, "approx": false, "cat": "", "form": "piano", "audio": "audio/satie_gymno.mp3", "loop": 17.143, "fact": "Le titre évoque les gymnopédies, des fêtes de la Grèce antique où de jeunes gens dansaient nus.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "mahler_1", "c": "mahler", "t": "Symphonie n°1, 3e mouvement", "y": 1888, "approx": false, "cat": "", "form": "contrebasse", "audio": "audio/mahler_1.mp3", "loop": 16.875, "fact": "Mahler transforme la comptine Frère Jacques en marche funèbre, en mineur, confiée à une contrebasse solo.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "dvorak_largo", "c": "dvorak", "t": "Symphonie « du Nouveau Monde », Largo", "y": 1893, "approx": false, "cat": "Op. 95", "form": "coranglais", "audio": "audio/dvorak_largo.mp3", "loop": 18, "fact": "Créée au Carnegie Hall en 1893, quand Dvořák dirigeait le Conservatoire de New York.", "stat": "C’était l’œuvre la plus jouée en concert en 2024 selon Bachtrack.", "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "debussy_faune", "c": "debussy", "t": "Prélude à l’après-midi d’un faune", "y": 1894, "approx": false, "cat": "L. 86", "form": "flute", "audio": "audio/debussy_faune.mp3", "loop": 11.739, "fact": "Inspiré d’un poème de Mallarmé. Pierre Boulez voyait dans ce solo de flûte le moment où la musique moderne s’éveille.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "rimsky_bourdon", "c": "rimsky", "t": "Le Vol du bourdon", "y": 1900, "approx": false, "cat": "", "form": "violon", "audio": "audio/rimsky_bourdon.mp3", "loop": 6.667, "fact": "Un interlude de l’opéra Le Conte du tsar Saltane, où le prince se change en bourdon pour piquer ses ennemis.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "rach_prelude", "c": "rachmaninov", "t": "Prélude en do dièse mineur", "y": 1892, "approx": false, "cat": "Op. 3 n°2", "form": null, "audio": "audio/rach_prelude.mp3", "loop": 13.333, "fact": "Écrit à 19 ans, ce prélude devint si célèbre que Rachmaninov finit par le détester : le public le réclamait à chaque concert.", "stat": null, "added": "2026-10-23", "retired": null, "src": null, "synth": true},
  {"id": "bach-goldberg-aria", "c": "bach", "t": "Variations Goldberg, Aria", "y": 1741, "approx": false, "cat": "BWV 988", "form": "piano", "audio": "audio/bach-goldberg-aria.mp3", "loop": null, "fact": "Selon le premier biographe de Bach, ces variations auraient été écrites pour un comte insomniaque, à qui son claveciniste Goldberg les jouait la nuit.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Bach_GoldbergVariations/JohannSebastianBach-01-GoldbergVariationsBwv.988-Aria.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Shelley Katz", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 4.04}, "synth": false},
  {"id": "beethoven-coriolan", "c": "beethoven", "t": "Coriolan, ouverture", "y": 1807, "approx": false, "cat": "Op. 62", "form": "orchestre", "audio": "audio/beethoven-coriolan.mp3", "loop": null, "fact": "Écrite pour la tragédie Coriolan de Heinrich von Collin, et non pour la pièce de Shakespeare. Beethoven y oppose un thème farouche et un thème suppliant.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Beethoven_CoriolanOverture/LudwigVanBeethoven-CoriolanOverture.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.17}, "synth": false},
  {"id": "beethoven-egmont", "c": "beethoven", "t": "Egmont, ouverture", "y": 1810, "approx": false, "cat": "Op. 84", "form": "orchestre", "audio": "audio/beethoven-egmont.mp3", "loop": null, "fact": "Musique de scène pour la tragédie de Goethe, qui raconte la révolte des Pays-Bas contre la domination espagnole.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Beethoven_EgmontOvertureOp.84/LudwigVanBeethoven-EgmontOvertureOp.84.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.0}, "synth": false},
  {"id": "beethoven-heroique", "c": "beethoven", "t": "Symphonie n°3 « Héroïque »", "y": 1804, "approx": false, "cat": "Op. 55", "form": "orchestre", "audio": "audio/beethoven-heroique.mp3", "loop": null, "fact": "Beethoven l’avait dédiée à Napoléon. Apprenant qu’il s’était proclamé empereur, il aurait rayé son nom de la page de titre si fort qu’il troua le papier.", "stat": "8e œuvre la plus jouée en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Beethoven_SymphonyNo.3Eroica/LudwigVanBeethoven-SymphonyNo.3InEFlatMajorEroicaOp.55-01-AllegroConBrio.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.0}, "synth": false},
  {"id": "borodine-steppes", "c": "borodin", "t": "Dans les steppes de l’Asie centrale", "y": 1880, "approx": false, "cat": "", "form": "orchestre", "audio": "audio/borodine-steppes.mp3", "loop": null, "fact": "Une caravane traverse le désert sous escorte russe : un chant russe et une mélodie orientale finissent par se superposer.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Borodin_InTheSteppesOfCentralAsia/AlexanderBorodin-InTheSteppesOfCentralAsia.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 186.36}, "synth": false},
  {"id": "borodine-quatuor-2-nocturne", "c": "borodin", "t": "Quatuor à cordes n°2, Nocturne", "y": 1881, "approx": false, "cat": "", "form": "quatuor", "audio": "audio/borodine-quatuor-2-nocturne.mp3", "loop": null, "fact": "Borodine, chimiste de métier, dédie ce quatuor à sa femme pour leurs vingt ans de rencontre. Le Nocturne est devenu une chanson de Broadway, « And This Is My Beloved ».", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Borodin_StringQuartetNo.2inDMajor/AlexanderBorodin-StringQuartetNo.2InDMajor-03-NocturneAndante.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Musopen String Quartet", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.37}, "synth": false},
  {"id": "brahms-symphonie-1-finale", "c": "brahms", "t": "Symphonie n°1, Finale", "y": 1876, "approx": false, "cat": "Op. 68", "form": "orchestre", "audio": "audio/brahms-symphonie-1-finale.mp3", "loop": null, "fact": "Brahms a mis une vingtaine d’années à l’achever. Le grand thème du finale rappelle l’« Ode à la joie », ce qu’il jugeait évident.", "stat": "9e œuvre la plus jouée en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Brahms_SymphonyNo.1inCMinor/JohannesBrahms-SymphonyNo.1InCMinorOp.68-04-Adagio-PiAndante-AllegroNonTroppoMaConBrio.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 145.64}, "synth": false},
  {"id": "brahms-symphonie-3-allegretto", "c": "brahms", "t": "Symphonie n°3, Poco allegretto", "y": 1883, "approx": false, "cat": "Op. 90", "form": "orchestre", "audio": "audio/brahms-symphonie-3-allegretto.mp3", "loop": null, "fact": "Ce mouvement mélancolique est l’un des plus connus de Brahms. Le cinéma l’a souvent repris, notamment dans « Aimez-vous Brahms ? » en 1961.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Brahms_SymphonyNo.3inFMajor/JohannesBrahms-SymphonyNo.3InFMajorOp.90-03-PocoAllegretto.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.0}, "synth": false},
  {"id": "dvorak-quatuor-americain", "c": "dvorak", "t": "Quatuor « Américain »", "y": 1893, "approx": false, "cat": "Op. 96", "form": "quatuor", "audio": "audio/dvorak-quatuor-americain.mp3", "loop": null, "fact": "Écrit en quelques jours à Spillville, un village de l’Iowa peuplé d’immigrés tchèques, pendant l’été 1893.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Dvorak_StringQuartetNo.12inFMajorOp.96/AntonnDvorak-StringQuartetNo.12InFMajorOp.96American-01-AllegroMaNonTroppo.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Musopen String Quartet", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 4.46}, "synth": false},
  {"id": "grieg-au-matin", "c": "grieg", "t": "Peer Gynt, « Au matin »", "y": 1875, "approx": false, "cat": "Op. 23", "form": "orchestre", "audio": "audio/grieg-au-matin.mp3", "loop": null, "fact": "Un lever de soleil… qui se passe dans le désert marocain, à l’acte IV de la pièce d’Ibsen. La flûte et le hautbois s’y répondent.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Greig_PeerGynt/EdvardGrieg-PeerGyntSuiteNo.1Op.46-01-Morning.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 45.52}, "synth": false},
  {"id": "grieg-mort-ase", "c": "grieg", "t": "Peer Gynt, « La Mort d’Åse »", "y": 1875, "approx": false, "cat": "Op. 23", "form": "cordes", "audio": "audio/grieg-mort-ase.mp3", "loop": null, "fact": "Une marche funèbre pour cordes seules : dans la pièce d’Ibsen, Peer Gynt veille sa mère mourante en lui racontant des histoires.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Greig_PeerGynt/EdvardGrieg-PeerGyntSuiteNo.1Op.46-02-AasesDeath.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 90.84}, "synth": false},
  {"id": "grieg-roi-montagne", "c": "grieg", "t": "Peer Gynt, « Dans l’antre du roi de la montagne »", "y": 1875, "approx": false, "cat": "Op. 23", "form": "orchestre", "audio": "audio/grieg-roi-montagne.mp3", "loop": null, "fact": "Musique de scène pour la pièce d’Ibsen. Grieg disait ne pas supporter ce morceau, qu’il trouvait d’un folklore trop appuyé.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Greig_PeerGynt/EdvardGrieg-PeerGyntSuiteNo.1Op.46-04-InTheHallOfTheMountainKing.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 121.07}, "synth": false},
  {"id": "haydn-alouette", "c": "haydn", "t": "Quatuor « L’Alouette »", "y": 1790, "approx": false, "cat": "Op. 64 n°5", "form": "quatuor", "audio": "audio/haydn-alouette.mp3", "loop": null, "fact": "Le surnom vient de la mélodie du premier violon, qui s’élève au-dessus des autres comme le chant d’une alouette.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Haydn_StringQuartetInDMajorOp.64/JosephHaydn-StringQuartetInDOp.645H363Lark-01-AllegroModerato.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Musopen String Quartet", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 36.48}, "synth": false},
  {"id": "mendelssohn-hebrides", "c": "mendelssohn", "t": "Les Hébrides, « La Grotte de Fingal »", "y": 1830, "approx": false, "cat": "Op. 26", "form": "orchestre", "audio": "audio/mendelssohn-hebrides.mp3", "loop": null, "fact": "Mendelssohn a noté le premier thème dans une lettre écrite pendant son voyage dans les îles Hébrides, en Écosse, en 1829.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Mendelssohn_Hebrides/FelixMendelssohn-HebridesOvertureFingalsCave.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.78}, "synth": false},
  {"id": "mendelssohn-italienne", "c": "mendelssohn", "t": "Symphonie n°4 « Italienne »", "y": 1833, "approx": false, "cat": "Op. 90", "form": "orchestre", "audio": "audio/mendelssohn-italienne.mp3", "loop": null, "fact": "Inspirée par un voyage en Italie en 1830-1831. Mendelssohn n’en était pas satisfait et ne l’a jamais publiée de son vivant.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Mendelssohn_ItalianSymphony/FelixMendelssohn-SymphonyNo.4InAMajorOp.90italian-01-AllegroVivace.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.0}, "synth": false},
  {"id": "mozart-flute-enchantee", "c": "mozart", "t": "La Flûte enchantée, ouverture", "y": 1791, "approx": false, "cat": "K. 620", "form": "orchestre", "audio": "audio/mozart-flute-enchantee.mp3", "loop": null, "fact": "Créée à Vienne le 30 septembre 1791, deux mois avant la mort de Mozart.", "stat": "La Flûte enchantée a été l’opéra le plus joué au monde en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Mozart_MagicFluteOverture/WolfgangAmadeusMozart-MagicFluteOverture.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 93.81}, "synth": false},
  {"id": "mozart-noces-figaro", "c": "mozart", "t": "Les Noces de Figaro, ouverture", "y": 1786, "approx": false, "cat": "K. 492", "form": "orchestre", "audio": "audio/mozart-noces-figaro.mp3", "loop": null, "fact": "Le livret de Lorenzo Da Ponte adapte la pièce de Beaumarchais, dont la représentation était alors interdite à Vienne.", "stat": "Les Noces de Figaro : 5e opéra le plus joué en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Mozart_MarriageOfFigaro/WolfgangAmadeusMozart-MarriageOfFigaro.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.0}, "synth": false},
  {"id": "mozart-symphonie-40", "c": "mozart", "t": "Symphonie n°40 en sol mineur", "y": 1788, "approx": false, "cat": "K. 550", "form": "orchestre", "audio": "audio/mozart-symphonie-40.mp3", "loop": null, "fact": "L’une des trois dernières symphonies de Mozart, toutes écrites en six semaines à l’été 1788.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Mozart_SymphonyNo.40inGMinor/WolfgangAmadeusMozart-SymphonyNo.40InGMinorK.550-01-MoltoAllegro.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.6}, "synth": false},
  {"id": "rimsky-grande-paque", "c": "rimsky", "t": "La Grande Pâque russe, ouverture", "y": 1888, "approx": false, "cat": "Op. 36", "form": "orchestre", "audio": "audio/rimsky-grande-paque.mp3", "loop": null, "fact": "Rimski-Korsakov y cite des chants liturgiques orthodoxes pour évoquer la nuit de Pâques.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Rimsky-Korsakov_RussianOverture/NikolaiRimsky-korsakov-RussianEasterFestivalOvertureOp.36.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 124.46}, "synth": false},
  {"id": "schubert-d959-andantino", "c": "schubert", "t": "Sonate pour piano D. 959, Andantino", "y": 1828, "approx": false, "cat": "D. 959", "form": "piano", "audio": "audio/schubert-d959-andantino.mp3", "loop": null, "fact": "L’une des trois dernières sonates, achevées en septembre 1828, deux mois avant la mort de Schubert. Robert Bresson a utilisé cet Andantino dans son film « Au hasard Balthazar ».", "stat": "Schubert a été le 6e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Schubert_SonataInAMinorD.959/FranzSchubert-SonataInAMinorD.959-02-Andantino.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Paul Pitman", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 2.42}, "synth": false},
  {"id": "smetana-moldau", "c": "smetana", "t": "Ma Patrie, « La Moldau »", "y": 1874, "approx": false, "cat": "", "form": "orchestre", "audio": "audio/smetana-moldau.mp3", "loop": null, "fact": "La musique suit la rivière Vltava, de ses deux sources jusqu’à Prague. Smetana l’écrit alors qu’il est devenu sourd.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Smetana_Vltava/BedichSmetana-MVlast-Vltava.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 94.25}, "synth": false},
  {"id": "tchaikovsky-pathetique", "c": "tchaikovsky", "t": "Symphonie n°6 « Pathétique », Finale", "y": 1893, "approx": false, "cat": "Op. 74", "form": "orchestre", "audio": "audio/tchaikovsky-pathetique.mp3", "loop": null, "fact": "Une symphonie qui finit dans un murmure, sur un mouvement lent et désolé. Tchaïkovski dirige la création le 28 octobre 1893 et meurt neuf jours plus tard.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:MusopenCollectionAsFlac/Tchaikovsky_SymphonyPathetique/PyotrIlyichTchaikovsky-SymphonyNo.6InBMinorOp.74pathtique-04-FinaleAdagioLamentoso.flac", "page": "https://archive.org/details/MusopenCollectionAsFlac", "artist": "Czech National Symphony Orchestra", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 1.51}, "synth": false},
  {"id": "beethoven-symphonie-5-finale", "c": "beethoven", "t": "Symphonie n°5, Finale", "y": 1808, "approx": false, "cat": "Op. 67", "form": "orchestre", "audio": "audio/beethoven-symphonie-5-finale.mp3", "loop": null, "fact": "Le finale éclate en ut majeur après trois mouvements sombres. Beethoven y ajoute à l’orchestre un piccolo, un contrebasson et trois trombones, absents jusque-là.", "stat": "Beethoven a été le compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:Musopen-Libre/SymphonyNo.5InCMinorOp.67-4.Allegro.mp3", "page": "https://archive.org/details/Musopen-Libre", "artist": "DHS Symphony Orchestra", "licence": "CC BY-SA 3.0", "licence_url": "http://creativecommons.org/licenses/by-sa/3.0/", "start": 0.08}, "synth": false},
  {"id": "beethoven-pastorale-paysans", "c": "beethoven", "t": "Symphonie n°6 « Pastorale », Joyeuse réunion de paysans", "y": 1808, "approx": false, "cat": "Op. 68", "form": "orchestre", "audio": "audio/beethoven-pastorale-paysans.mp3", "loop": null, "fact": "Beethoven a donné un titre à chacun des cinq mouvements. Celui-ci décrit une fête au village, interrompue par l’orage du mouvement suivant.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:Musopen-Libre/SymphonyNo.6InFMajorpastoralOp.68-3.Allegro.mp3", "page": "https://archive.org/details/Musopen-Libre", "artist": "Musopen and others", "licence": "CC BY-SA 3.0", "licence_url": "http://creativecommons.org/licenses/by-sa/3.0/", "start": 34.11}, "synth": false},
  {"id": "bach-prelude-ut", "c": "bach", "t": "Prélude en do majeur, Clavier bien tempéré", "y": 1722, "approx": false, "cat": "BWV 846", "form": null, "audio": "audio/bach-prelude-ut.mp3", "loop": null, "fact": "Premier prélude d’un recueil qui parcourt les 24 tonalités. En 1853, Gounod lui superpose une mélodie : c’est son célèbre Ave Maria.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:bach-well-tempered-clavier-book-1/Kimiko Ishizaka - Bach- Well-Tempered Clavier, Book 1 - 01 Prelude No. 1 in C major, BWV 846.flac", "page": "https://archive.org/details/bach-well-tempered-clavier-book-1", "artist": "Kimiko Ishizaka", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 1.34}, "synth": false},
  {"id": "bach-prelude-ut-mineur", "c": "bach", "t": "Prélude en do mineur, Clavier bien tempéré", "y": 1722, "approx": false, "cat": "BWV 847", "form": "piano", "audio": "audio/bach-prelude-ut-mineur.mp3", "loop": null, "fact": "Le deuxième prélude du recueil : un flot ininterrompu de doubles croches aux deux mains, qui s’emballe juste avant la fin.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:bach-well-tempered-clavier-book-1/Kimiko Ishizaka - Bach- Well-Tempered Clavier, Book 1 - 03 Prelude No. 2 in C minor, BWV 847.flac", "page": "https://archive.org/details/bach-well-tempered-clavier-book-1", "artist": "Kimiko Ishizaka", "licence": "Domaine public (Public Domain Mark)", "licence_url": "http://creativecommons.org/publicdomain/mark/1.0/", "start": 0.39}, "synth": false},
  {"id": "chopin-nocturne-9-2", "c": "chopin", "t": "Nocturne op. 9 n°2", "y": 1832, "approx": true, "cat": "Op. 9 n°2", "form": "piano", "audio": "audio/chopin-nocturne-9-2.mp3", "loop": null, "fact": "Chopin a emprunté le nom de « nocturne » au compositeur irlandais John Field, qui avait inventé le genre.", "stat": "Chopin a été le 7e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Nocturne Op. 9 no. 2 in E flat major.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 0.0}, "synth": false},
  {"id": "chopin-fantaisie-impromptu", "c": "chopin", "t": "Fantaisie-Impromptu", "y": 1834, "approx": false, "cat": "Op. 66", "form": "piano", "audio": "audio/chopin-fantaisie-impromptu.mp3", "loop": null, "fact": "Chopin ne l’a jamais publiée : elle est parue en 1855, après sa mort, grâce à son ami Julian Fontana.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Fantasie Impromptu Op. 66.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 0.9}, "synth": false},
  {"id": "chopin-valse-minute", "c": "chopin", "t": "Valse « Minute »", "y": 1847, "approx": false, "cat": "Op. 64 n°1", "form": "piano", "audio": "audio/chopin-valse-minute.mp3", "loop": null, "fact": "« Minute » veut dire « petite » : la valse dure en général plus d’une minute. On la surnomme aussi la valse du petit chien.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Waltz Op. 64 no. 1 in D flat major.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 1.78}, "synth": false},
  {"id": "chopin-goutte-eau", "c": "chopin", "t": "Prélude « La Goutte d’eau »", "y": 1839, "approx": false, "cat": "Op. 28 n°15", "form": "piano", "audio": "audio/chopin-goutte-eau.mp3", "loop": null, "fact": "Composé à Majorque pendant l’hiver 1838-1839, auprès de George Sand. La note répétée tout au long de la pièce évoquerait la pluie.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Prelude Op. 28 no. 15.mp3", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 0.93}, "synth": false},
  {"id": "chopin-polonaise-heroique", "c": "chopin", "t": "Polonaise « Héroïque »", "y": 1842, "approx": false, "cat": "Op. 53", "form": "piano", "audio": "audio/chopin-polonaise-heroique.mp3", "loop": null, "fact": "La polonaise est une danse de cour polonaise. Exilé à Paris, Chopin en a fait un symbole de son pays.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/PolonaiseOp.53InAFlatMajorheroic.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 86.01}, "synth": false},
  {"id": "chopin-ballade-1", "c": "chopin", "t": "Ballade n°1", "y": 1835, "approx": false, "cat": "Op. 23", "form": "piano", "audio": "audio/chopin-ballade-1.mp3", "loop": null, "fact": "Chopin est le premier à donner le nom de « ballade » à une pièce pour piano seul. Selon Schumann, c’était l’une des œuvres préférées de Chopin lui-même.", "stat": "Chopin a été le 7e compositeur le plus joué en concert en 2025 (Bachtrack).", "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Ballade no. 1 - Op. 23.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 143.58}, "synth": false},
  {"id": "chopin-grande-valse-brillante", "c": "chopin", "t": "Grande Valse brillante", "y": 1833, "approx": false, "cat": "Op. 18", "form": "piano", "audio": "audio/chopin-grande-valse-brillante.mp3", "loop": null, "fact": "La première valse publiée par Chopin, en 1834 : une valse brillante, pensée pour le salon autant que pour le bal.", "stat": null, "added": "2026-10-25", "retired": null, "src": {"file": "ia:musopen-chopin/Grande Valse Brilliante Op.18 In E flat major.m4a", "page": "https://archive.org/details/musopen-chopin", "artist": "Musopen", "licence": "CC0", "licence_url": "http://creativecommons.org/publicdomain/zero/1.0/", "start": 23.1}, "synth": false},
